# 校园墙部署机 —— fail2ban
# 安装到 /etc/fail2ban/jail.d/school-wall.local

[DEFAULT]
# 默认只豁免本机回环。确有需要时由运维显式添加受信任的固定管理 IP，
# 不把历史开发机地址或整个局域网作为所有部署的默认白名单。
ignoreip = 127.0.0.1/8 ::1

bantime  = 1h
findtime = 10m
maxretry = 3
# 重复触发的 IP 逐次延长封禁（1h → 2h → 4h …），上限 1 天
bantime.increment = true
bantime.maxtime = 1d

[sshd]
enabled = true
mode    = aggressive
maxretry = 3

# 刻意不为 nginx 的 429 建 jail。
# 校园网常常整栋楼共用一个出口 IP，按 IP 封禁会把一大批正常用户一起关在外面；
# 触发限流时 nginx 已经返回 429，这就是正确的处理方式，不需要再升级成封禁。
