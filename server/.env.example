# This file is a template only. Node does not read .env automatically.
# From the repository root: node --env-file=server/.env server/index.js
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
KEEP_DB=1
# 0 = API/dashboard backend only; 1 = also serve client/dist when available.
SERVE_CLIENT=0
# Enable only behind a controlled proxy that overwrites forwarding headers.
TRUST_PROXY=0
# Exact browser origins, comma-separated; leave blank with a same-origin proxy.
ALLOWED_ORIGINS=
# Prefer an absolute directory outside the checkout for persistent production data.
# DATA_DIR=/var/lib/school-wall
# Omit JWT_SECRET to let the app persist a generated secret in DATA_DIR.
# If set, use a long cryptographically random value, never a sample/shared value.
# JWT_SECRET=
# The packaged systemd/nginx installer supplies its own fixed HOST/PORT/TRUST_PROXY/
# KEEP_DB/NODE_ENV/SERVE_CLIENT. Remove those assignments here when using that service.
