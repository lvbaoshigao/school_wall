# Vite loads client/.env automatically. All VITE_ values are public build inputs.
VITE_PORT=5173
VITE_BACKEND_PORT=3000
# Optional development proxy target for a backend on another host/container.
# BACKEND_ORIGIN takes precedence over VITE_BACKEND_PORT. Use an origin only.
# BACKEND_ORIGIN=http://127.0.0.1:3000
# The app calls /api, /uploads etc. in production: configure a same-origin reverse
# proxy to the backend; Vite's development proxy is not part of the static build.
